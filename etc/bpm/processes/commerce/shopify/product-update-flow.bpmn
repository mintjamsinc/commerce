<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Product onboarding flow. Started from the products/create & products/update route
       (product-update.xml), guarded against duplicate instances per product. Its job is
       ONBOARDING: ensure the product has an inventory threshold (prompting an operator when
       it does not), then enqueue the product's inventory items for alert evaluation.

       The low-stock ALERT itself is no longer decided here: the trigger moved to
       inventory_levels/update,
       evaluated by the inventory-alert sweep (sweepInventoryAlerts.groovy) which raises
       inventory-alert-flow. So this flow ends by enqueuing the product's items pending, and
       the sweep evaluates current stock against the threshold (covering an already-low product
       the moment its threshold is first set). -->
  <bpmn:process id="product-update-flow" name="Product Update Flow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_5a40e714">
      <bpmn:outgoing>Flow_start_threshold</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. Check whether this product already has an inventory threshold config -->
    <bpmn:serviceTask id="ServiceTask_checkThreshold" name="Check Threshold Config" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/checkThresholdConfig.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>productPath</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>hasThresholdConfig</camunda:string>
        </camunda:field>
        <!-- The BPM engine runs service tasks on its own thread with no JCR identity;
             without runAs the CmsDelegate logs in as guest and cannot even read this
             script (/etc/commerce is denied to anonymous). Run as the service user,
             consistent with the mutating tasks in this flow. -->
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_threshold</bpmn:incoming>
      <bpmn:outgoing>Flow_threshold_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2. Threshold configured? -->
    <bpmn:exclusiveGateway id="Gateway_thresholdConfigured" name="Threshold configured?">
      <bpmn:incoming>Flow_threshold_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_threshold_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_threshold_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 2a. No threshold yet: operator sets it via a manual task -->
    <bpmn:userTask id="UserTask_setThreshold" name="Set Inventory Threshold" camunda:formKey="cms:/content/commerce/forms/shopify/inventory-threshold-config.html">
      <bpmn:extensionElements>
        <!-- Advance the processing status to "threshold_pending" (waiting on an operator). -->
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>productPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/notifyTaskCreated.groovy</camunda:string>
          </camunda:field>
          <!-- Task listeners run with no JCR identity; runAs avoids a guest login
               that cannot read this script (matches the setWorkflowStatus listener). -->
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_threshold_no</bpmn:incoming>
      <bpmn:outgoing>Flow_setThreshold_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2b. Join the two threshold branches -->
    <bpmn:exclusiveGateway id="Gateway_thresholdJoin">
      <bpmn:incoming>Flow_threshold_yes</bpmn:incoming>
      <bpmn:incoming>Flow_setThreshold_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_0b9f3301">
      <bpmn:extensionElements>
        <!-- Workflow finished: mark the product as "monitored" (terminal status). -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>productPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
        <!-- Enqueue the product's inventory items for alert evaluation, so the sweep checks
             current stock against the (now configured) threshold. -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/enqueueProductInventoryPending.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>productPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_start_threshold" sourceRef="StartEvent_5a40e714" targetRef="ServiceTask_checkThreshold"/>
    <bpmn:sequenceFlow id="Flow_threshold_gw" sourceRef="ServiceTask_checkThreshold" targetRef="Gateway_thresholdConfigured"/>
    <bpmn:sequenceFlow id="Flow_threshold_no" name="No" sourceRef="Gateway_thresholdConfigured" targetRef="UserTask_setThreshold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasThresholdConfig == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_threshold_yes" name="Yes" sourceRef="Gateway_thresholdConfigured" targetRef="Gateway_thresholdJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasThresholdConfig == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_setThreshold_join" sourceRef="UserTask_setThreshold" targetRef="Gateway_thresholdJoin"/>
    <bpmn:sequenceFlow id="Flow_join_end" sourceRef="Gateway_thresholdJoin" targetRef="EndEvent_0b9f3301"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="product-update-flow">
      <bpmndi:BPMNShape id="f1bd3242-f4be-4df7-b43c-83a6888a3ce7" bpmnElement="StartEvent_5a40e714">
        <dc:Bounds x="140" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_30fb507b-850f-4fab-95af-fd76b59267dc" bpmnElement="ServiceTask_checkThreshold">
        <dc:Bounds x="240" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_12f49948-23bc-44b5-b618-e58ec6508d99" bpmnElement="Gateway_thresholdConfigured">
        <dc:Bounds x="400" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="449" y="169" width="76" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_55a81265-aa46-4768-a64c-f8ed902bf28f" bpmnElement="UserTask_setThreshold">
        <dc:Bounds x="460" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_688cda3d-b00a-47dc-8c8c-2b05f6259912" bpmnElement="Gateway_thresholdJoin">
        <dc:Bounds x="570" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_37e5d2f9-3df7-43a8-a712-e3d23f6ed14b" bpmnElement="EndEvent_0b9f3301">
        <dc:Bounds x="682" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c304ed12-c7b9-4ffa-bcd5-2ec2199c1019" bpmnElement="Flow_start_threshold">
        <di:waypoint x="176" y="220"/>
        <di:waypoint x="240" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a34b0924-c1ed-4059-bf5a-f49c4873e7c0" bpmnElement="Flow_threshold_gw">
        <di:waypoint x="340" y="220"/>
        <di:waypoint x="400" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fd4d3070-8368-4c40-a753-ad39054fae6f" bpmnElement="Flow_threshold_no">
        <di:waypoint x="425" y="245"/>
        <di:waypoint x="425" y="320"/>
        <di:waypoint x="460" y="320"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="409" y="271" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_61c6b6fc-4bcd-4881-9132-91f9e79c7c76" bpmnElement="Flow_threshold_yes">
        <di:waypoint x="450" y="220"/>
        <di:waypoint x="570" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482" y="209" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_0b53476e-33d6-453b-822f-bb8016f823b1" bpmnElement="Flow_setThreshold_join">
        <di:waypoint x="560" y="320"/>
        <di:waypoint x="595" y="320"/>
        <di:waypoint x="595" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_27bc935c-0703-4550-814c-4f86c362d24c" bpmnElement="Flow_join_end">
        <di:waypoint x="620" y="220"/>
        <di:waypoint x="682" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
