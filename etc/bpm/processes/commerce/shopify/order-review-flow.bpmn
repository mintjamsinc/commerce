<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_order_review" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- The process key stays "order-review-flow" (the order-paid route starts it
       by this key). The flow now spans the whole order lifecycle: screen ->
       (review) -> approve -> fulfill -> (fulfill | close) -> record fulfillment.
       The close branch exists for orders cancelled in Shopify while the Fulfill
       Order task was claimed: the assignee closes without fulfilling and the
       Shopify fulfillment write-back is bypassed. -->
  <bpmn:process id="order-review-flow" name="Order Processing Flow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_start">
      <bpmn:outgoing>Flow_start_screen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. Screen the order against the configured review rules. Produces the
         requiresReview decision and the human-readable reasons behind it. -->
    <bpmn:serviceTask id="ServiceTask_screenOrder" name="Screen Order" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/screenOrder.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>requiresReview,reviewReasons</camunda:string>
        </camunda:field>
        <!-- The BPM engine runs service tasks on its own thread with no JCR identity;
             without runAs the CmsDelegate logs in as guest and cannot even read this
             script (/etc/commerce is denied to anonymous). Run as the service user,
             consistent with the approveOrder / createFulfillment tasks in this flow. -->
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_screen</bpmn:incoming>
      <bpmn:outgoing>Flow_screen_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2. Review required? -->
    <bpmn:exclusiveGateway id="Gateway_reviewRequired" name="Review required?">
      <bpmn:incoming>Flow_screen_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_review_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_review_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 2a. A rule matched: an operator reviews the order via a manual task. -->
    <bpmn:userTask id="UserTask_orderReview" name="Order Review" camunda:formKey="cms:/content/commerce/forms/shopify/order-review.html">
      <bpmn:extensionElements>
        <!-- Advance the processing status to "review_pending" (waiting on an operator). -->
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>orderPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/notifyOrderTaskCreated.groovy</camunda:string>
          </camunda:field>
          <!-- Task listeners run with no JCR identity; runAs avoids a guest login
               that cannot read this script (matches the setOrderWorkflowStatus listener). -->
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_review_decision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2a-2. Read the reviewer's decision (approved | rejected) off the order
         node — the review form wrote it before completing the task. Absent
         decision defaults to approved (pre-rejection behaviour). -->
    <bpmn:serviceTask id="ServiceTask_readDecision" name="Read Review Decision" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/readOrderReviewDecision.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>reviewDecision</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_decision_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2a-3. Approved or rejected? -->
    <bpmn:exclusiveGateway id="Gateway_decision" name="Approved?">
      <bpmn:incoming>Flow_decision_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_decision_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_decision_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 2a-4. Rejected: cancel the order in Shopify (restock+refund, the
         operator's reason as the staff note). The cancellation echoes back via
         webhook; the CMS records only the outbound call + audit. -->
    <bpmn:serviceTask id="ServiceTask_cancelOrder" name="Cancel Order (Shopify)" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/cancelOrder.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath,order_id</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_decision_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_cancel_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_orderCancelled">
      <bpmn:extensionElements>
        <!-- Workflow finished on the reject branch: mark the order "cancelled". -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>orderPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cancel_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 2b. Join the auto-approve and reviewed-approved branches. -->
    <bpmn:exclusiveGateway id="Gateway_reviewJoin">
      <bpmn:incoming>Flow_review_no</bpmn:incoming>
      <bpmn:incoming>Flow_decision_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_join_approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 3. Mark the order approved (cleared for fulfillment). Reached whether the
         order was auto-approved or a manual review was completed. -->
    <bpmn:serviceTask id="ServiceTask_approveOrder" name="Approve Order" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_fulfill</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 4. Fulfillment: a warehouse operator picks/packs and records tracking. -->
    <bpmn:userTask id="UserTask_fulfillOrder" name="Fulfill Order" camunda:formKey="cms:/content/commerce/forms/shopify/order-fulfillment.html">
      <bpmn:extensionElements>
        <!-- Advance the processing status to "fulfillment_pending" (waiting on a fulfiller). -->
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>orderPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/notifyFulfillmentTaskCreated.groovy</camunda:string>
          </camunda:field>
          <!-- Task listeners run with no JCR identity; runAs avoids a guest login
               that cannot read this script (matches the setOrderWorkflowStatus listener). -->
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approve_fulfill</bpmn:incoming>
      <bpmn:outgoing>Flow_fulfill_decision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 4a. Read the fulfiller's decision (fulfill | close) off the order node —
         the fulfillment form wrote it before completing the task. Absent
         decision defaults to fulfill (pre-cancellation behaviour). -->
    <bpmn:serviceTask id="ServiceTask_readFulfillmentDecision" name="Read Fulfillment Decision" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/readFulfillmentDecision.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>fulfillmentDecision</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fulfill_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_fulfillDecision_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 4b. Fulfilled, or closed without fulfilling? The close branch is taken
         when the order was cancelled in Shopify and the assignee confirmed the
         close: the Shopify fulfillment write-back must be bypassed. -->
    <bpmn:exclusiveGateway id="Gateway_fulfillmentDecision" name="Fulfilled?">
      <bpmn:incoming>Flow_fulfillDecision_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_fulfillment_fulfill</bpmn:outgoing>
      <bpmn:outgoing>Flow_fulfillment_close</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_orderClosedUnfulfilled">
      <bpmn:extensionElements>
        <!-- Workflow finished on the close branch: the order was cancelled in
             Shopify, so it ends "cancelled" without any fulfillment write-back. -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>orderPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fulfillment_close</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 5. Record the fulfillment: persist tracking metadata and, when the Admin
         API is enabled, write the fulfillment back to Shopify (best-effort). -->
    <bpmn:serviceTask id="ServiceTask_createFulfillment" name="Create Fulfillment" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/recordFulfillment.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>orderPath,order_id</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fulfillment_fulfill</bpmn:incoming>
      <bpmn:outgoing>Flow_record_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_orderProcessing">
      <bpmn:extensionElements>
        <!-- Workflow finished: mark the order as "fulfilled" (terminal status). -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setOrderWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>orderPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_record_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_start_screen" sourceRef="StartEvent_start" targetRef="ServiceTask_screenOrder"/>
    <bpmn:sequenceFlow id="Flow_screen_gw" sourceRef="ServiceTask_screenOrder" targetRef="Gateway_reviewRequired"/>
    <bpmn:sequenceFlow id="Flow_review_no" name="No" sourceRef="Gateway_reviewRequired" targetRef="Gateway_reviewJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresReview == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review_yes" name="Yes" sourceRef="Gateway_reviewRequired" targetRef="UserTask_orderReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresReview == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review_decision" sourceRef="UserTask_orderReview" targetRef="ServiceTask_readDecision"/>
    <bpmn:sequenceFlow id="Flow_decision_gw" sourceRef="ServiceTask_readDecision" targetRef="Gateway_decision"/>
    <bpmn:sequenceFlow id="Flow_decision_approved" name="Yes" sourceRef="Gateway_decision" targetRef="Gateway_reviewJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewDecision != 'rejected'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_decision_rejected" name="No" sourceRef="Gateway_decision" targetRef="ServiceTask_cancelOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reviewDecision == 'rejected'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_cancel_end" sourceRef="ServiceTask_cancelOrder" targetRef="EndEvent_orderCancelled"/>
    <bpmn:sequenceFlow id="Flow_join_approve" sourceRef="Gateway_reviewJoin" targetRef="ServiceTask_approveOrder"/>
    <bpmn:sequenceFlow id="Flow_approve_fulfill" sourceRef="ServiceTask_approveOrder" targetRef="UserTask_fulfillOrder"/>
    <bpmn:sequenceFlow id="Flow_fulfill_decision" sourceRef="UserTask_fulfillOrder" targetRef="ServiceTask_readFulfillmentDecision"/>
    <bpmn:sequenceFlow id="Flow_fulfillDecision_gw" sourceRef="ServiceTask_readFulfillmentDecision" targetRef="Gateway_fulfillmentDecision"/>
    <bpmn:sequenceFlow id="Flow_fulfillment_fulfill" name="Yes" sourceRef="Gateway_fulfillmentDecision" targetRef="ServiceTask_createFulfillment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fulfillmentDecision != 'close'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fulfillment_close" name="No" sourceRef="Gateway_fulfillmentDecision" targetRef="EndEvent_orderClosedUnfulfilled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fulfillmentDecision == 'close'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_record_end" sourceRef="ServiceTask_createFulfillment" targetRef="EndEvent_orderProcessing"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_order_review">
    <bpmndi:BPMNPlane id="BPMNPlane_order_review" bpmnElement="order-review-flow">
      <bpmndi:BPMNShape id="Shape_StartEvent_start" bpmnElement="StartEvent_start">
        <dc:Bounds x="140" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_screenOrder" bpmnElement="ServiceTask_screenOrder">
        <dc:Bounds x="230" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_reviewRequired" bpmnElement="Gateway_reviewRequired">
        <dc:Bounds x="385" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="377" y="169" width="76" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_orderReview" bpmnElement="UserTask_orderReview">
        <dc:Bounds x="450" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_readDecision" bpmnElement="ServiceTask_readDecision">
        <dc:Bounds x="590" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_decision" bpmnElement="Gateway_decision">
        <dc:Bounds x="720" y="315" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="712" y="289" width="66" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_cancelOrder" bpmnElement="ServiceTask_cancelOrder">
        <dc:Bounds x="695" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_orderCancelled" bpmnElement="EndEvent_orderCancelled">
        <dc:Bounds x="852" y="442" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_reviewJoin" bpmnElement="Gateway_reviewJoin">
        <dc:Bounds x="535" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_approveOrder" bpmnElement="ServiceTask_approveOrder">
        <dc:Bounds x="635" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_fulfillOrder" bpmnElement="UserTask_fulfillOrder">
        <dc:Bounds x="790" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_readFulfillmentDecision" bpmnElement="ServiceTask_readFulfillmentDecision">
        <dc:Bounds x="930" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_fulfillmentDecision" bpmnElement="Gateway_fulfillmentDecision">
        <dc:Bounds x="1065" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1063" y="169" width="54" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_orderClosedUnfulfilled" bpmnElement="EndEvent_orderClosedUnfulfilled">
        <dc:Bounds x="1072" y="320" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_createFulfillment" bpmnElement="ServiceTask_createFulfillment">
        <dc:Bounds x="1160" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_orderProcessing" bpmnElement="EndEvent_orderProcessing">
        <dc:Bounds x="1317" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_screen" bpmnElement="Flow_start_screen">
        <di:waypoint x="176" y="220"/>
        <di:waypoint x="230" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_screen_gw" bpmnElement="Flow_screen_gw">
        <di:waypoint x="330" y="220"/>
        <di:waypoint x="385" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_no" bpmnElement="Flow_review_no">
        <di:waypoint x="435" y="220"/>
        <di:waypoint x="535" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="202" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_yes" bpmnElement="Flow_review_yes">
        <di:waypoint x="410" y="245"/>
        <di:waypoint x="410" y="340"/>
        <di:waypoint x="450" y="340"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="271" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_decision" bpmnElement="Flow_review_decision">
        <di:waypoint x="550" y="340"/>
        <di:waypoint x="590" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_decision_gw" bpmnElement="Flow_decision_gw">
        <di:waypoint x="690" y="340"/>
        <di:waypoint x="720" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_decision_approved" bpmnElement="Flow_decision_approved">
        <di:waypoint x="745" y="315"/>
        <di:waypoint x="745" y="220"/>
        <di:waypoint x="585" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="260" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_decision_rejected" bpmnElement="Flow_decision_rejected">
        <di:waypoint x="745" y="365"/>
        <di:waypoint x="745" y="420"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="385" width="18" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_cancel_end" bpmnElement="Flow_cancel_end">
        <di:waypoint x="795" y="460"/>
        <di:waypoint x="852" y="460"/>
      </bpmndi:BPMNEdge>
