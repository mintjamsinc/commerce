<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_refund_review" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Refund processing workflow. Started by the refund-created ingestion route
       (a sibling of the order-paid route) when a refunds/create webhook arrives. A refund is
       already executed in Shopify by the time we hear about it, so this flow is
       audit/triage only: screen the refund, raise a manual "Refund Review" task
       when a rule matches, then record the refund (and update the linked order's
       refund summary). No money is moved and nothing is written back to Shopify. -->
  <bpmn:process id="refund-review-flow" name="Refund Processing Flow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_start">
      <bpmn:outgoing>Flow_start_screen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. Screen the refund against the configured review rules. -->
    <bpmn:serviceTask id="ServiceTask_screenRefund" name="Screen Refund" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/screenRefund.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>refundPath,order_id</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>requiresReview,reviewReasons</camunda:string>
        </camunda:field>
        <!-- The BPM engine runs service tasks on its own thread with no JCR identity;
             without runAs the CmsDelegate logs in as guest and cannot even read this
             script (/etc/commerce is denied to anonymous). Run as the service user,
             consistent with the recordRefund task in this flow. -->
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_screen</bpmn:incoming>
      <bpmn:outgoing>Flow_screen_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2. Review required? -->
    <bpmn:exclusiveGateway id="Gateway_reviewRequired" name="Review required?">
      <bpmn:incoming>Flow_screen_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_review_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_review_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 2a. A rule matched: an operator reviews the refund. -->
    <bpmn:userTask id="UserTask_refundReview" name="Refund Review" camunda:formKey="cms:/content/commerce/forms/shopify/refund-review.html">
      <bpmn:extensionElements>
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setRefundWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>refundPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
        <camunda:taskListener event="create" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/notifyRefundTaskCreated.groovy</camunda:string>
          </camunda:field>
          <!-- Task listeners run with no JCR identity; runAs avoids a guest login
               that cannot read this script (matches the setRefundWorkflowStatus listener). -->
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:taskListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_review_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 2b. Join the auto-acknowledge and reviewed branches. -->
    <bpmn:exclusiveGateway id="Gateway_reviewJoin">
      <bpmn:incoming>Flow_review_no</bpmn:incoming>
      <bpmn:incoming>Flow_review_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_record</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 3. Record the refund: persist computed totals on the refund and update
         the linked order's cumulative refund summary. -->
    <bpmn:serviceTask id="ServiceTask_recordRefund" name="Record Refund" camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/commerce/scripts/shopify/recordRefund.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>refundPath,order_id</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>commerce-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_refundProcessing">
      <bpmn:extensionElements>
        <!-- Workflow finished: mark the refund as "resolved" (terminal status). -->
        <camunda:executionListener event="end" class="org.mintjams.script.bpm.CmsDelegate">
          <camunda:field name="path">
            <camunda:string>/etc/commerce/scripts/shopify/setRefundWorkflowStatus.groovy</camunda:string>
          </camunda:field>
          <camunda:field name="inputs">
            <camunda:string>refundPath</camunda:string>
          </camunda:field>
          <camunda:field name="runAs">
            <camunda:string>commerce-service-user</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_record_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_start_screen" sourceRef="StartEvent_start" targetRef="ServiceTask_screenRefund"/>
    <bpmn:sequenceFlow id="Flow_screen_gw" sourceRef="ServiceTask_screenRefund" targetRef="Gateway_reviewRequired"/>
    <bpmn:sequenceFlow id="Flow_review_no" name="No" sourceRef="Gateway_reviewRequired" targetRef="Gateway_reviewJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresReview == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review_yes" name="Yes" sourceRef="Gateway_reviewRequired" targetRef="UserTask_refundReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresReview == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review_join" sourceRef="UserTask_refundReview" targetRef="Gateway_reviewJoin"/>
    <bpmn:sequenceFlow id="Flow_join_record" sourceRef="Gateway_reviewJoin" targetRef="ServiceTask_recordRefund"/>
    <bpmn:sequenceFlow id="Flow_record_end" sourceRef="ServiceTask_recordRefund" targetRef="EndEvent_refundProcessing"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_refund_review">
    <bpmndi:BPMNPlane id="BPMNPlane_refund_review" bpmnElement="refund-review-flow">
      <bpmndi:BPMNShape id="Shape_StartEvent_start" bpmnElement="StartEvent_start">
        <dc:Bounds x="140" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_screenRefund" bpmnElement="ServiceTask_screenRefund">
        <dc:Bounds x="230" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_reviewRequired" bpmnElement="Gateway_reviewRequired">
        <dc:Bounds x="385" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="377" y="169" width="76" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_refundReview" bpmnElement="UserTask_refundReview">
        <dc:Bounds x="450" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_reviewJoin" bpmnElement="Gateway_reviewJoin">
        <dc:Bounds x="535" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_recordRefund" bpmnElement="ServiceTask_recordRefund">
        <dc:Bounds x="635" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_refundProcessing" bpmnElement="EndEvent_refundProcessing">
        <dc:Bounds x="792" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_screen" bpmnElement="Flow_start_screen">
        <di:waypoint x="176" y="220"/>
        <di:waypoint x="230" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_screen_gw" bpmnElement="Flow_screen_gw">
        <di:waypoint x="330" y="220"/>
        <di:waypoint x="385" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_no" bpmnElement="Flow_review_no">
        <di:waypoint x="435" y="220"/>
        <di:waypoint x="535" y="220"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="202" width="15" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_yes" bpmnElement="Flow_review_yes">
        <di:waypoint x="410" y="245"/>
        <di:waypoint x="410" y="340"/>
        <di:waypoint x="450" y="340"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="271" width="20" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_join" bpmnElement="Flow_review_join">
        <di:waypoint x="550" y="340"/>
        <di:waypoint x="560" y="340"/>
        <di:waypoint x="560" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_join_record" bpmnElement="Flow_join_record">
        <di:waypoint x="585" y="220"/>
        <di:waypoint x="635" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_record_end" bpmnElement="Flow_record_end">
        <di:waypoint x="735" y="220"/>
        <di:waypoint x="792" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
