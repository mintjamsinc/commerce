<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <routeConfiguration id="shopify-order-transaction-created-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <redeliveryPolicy maximumRedeliveries="3" redeliveryDelay="5000"/>

            <!-- Log error details -->
            <log message="Shopify order transaction created error [${exchangeId}]: ${exception.message} [file: ${header.paymentPath}]"
                 loggingLevel="ERROR"/>

            <!-- Set error metadata as headers for JCR properties -->
            <setHeader name="commerce:status">
                <constant>error</constant>
            </setHeader>
            <setHeader name="commerce:errorMessage">
                <simple>${exception.message}</simple>
            </setHeader>
            <setHeader name="commerce:stackTrace">
                <simple>${exception.stacktrace}</simple>
            </setHeader>
            <toD uri="transform:truncateString?targets=commerce:stackTrace&amp;maxLength=2048"/>

            <!-- Write error metadata to JCR node properties -->
            <toD uri="cms:setProperties?path=${header.paymentPath}&amp;includes=commerce:*"/>
            <!-- Move file to error folder -->
            <toD uri="cms:move?sourcePath=${header.paymentPath}&amp;destPath=/content/commerce/payments/error"/>

            <!-- Record processing health (error) -->
            <setHeader name="health_group">
                <constant>route</constant>
            </setHeader>
            <setHeader name="health_name">
                <simple>${header.shopify_topic}</simple>
            </setHeader>
            <setHeader name="health_ok">
                <constant>false</constant>
            </setHeader>
            <setHeader name="health_error">
                <simple>${exception.message}</simple>
            </setHeader>
            <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
        </onException>
    </routeConfiguration>

    <!--
      Bespoke order_transactions/create ingestion — the PAYMENT (cash-in) axis of the
      occurrence-date sales report. orders/paid fires only on the FIRST full payment
      of an order, so surcharge captures (Order Editing) and bank transfers marked
      paid later never reach the order route; this route captures EVERY transaction
      event and mirrors the cash-in ones (kind sale/capture, status success — the
      commerce.Payments.isCashIn judgment) as one node per transaction under
      /content/commerce/payments/raw, keyed by the payment's OWN date (paid_at).
      Non-cash-in kinds (authorization / void / failures) move no money and are
      skipped; kind=refund is skipped because refund cash-out is anchored by the
      refund store (a payment node for it would double-count).

      Mirror-only: no BPMN flow, no order-lifecycle writes, and no sales-fact
      enqueue — the report reads the payment store directly (facet accumulate on
      commerce:paid_at), exactly as the refund columns read the refund store.
    -->
    <route id="shopify-order-transaction-created" routeConfigurationId="shopify-order-transaction-created-error-handler">
        <from uri="direct:shopify-order-transaction-created"/>

        <!-- Include headers for history tracking -->
        <setHeader name="mi:history.header.includes">
            <constant>commerce:*</constant>
        </setHeader>

        <!-- Inherit the caller's identity from the ingest core (the service user
             for webhook traffic, or the operator who replayed the event); fall back
             to the service user when none was supplied. -->
        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>

        <!-- Save original body before idempotency check (cms:exists overwrites body) -->
        <setHeader name="shopify_payload">
            <simple>${body}</simple>
        </setHeader>

        <!-- Idempotency check: skip if this webhook was already processed -->
        <toD uri="cms:exists?query=/jcr:root/content/commerce/history/webhooks/${header.shopify_webhook_id}&amp;@header.webhookAlreadyProcessed=exists"/>

        <choice>
            <when>
                <simple>${header.webhookAlreadyProcessed} == true &amp;&amp; ${header.replay} != 'true'</simple>
                <log message="Duplicate webhook ${header.shopify_webhook_id} - skipping"
                     loggingLevel="INFO"/>
            </when>
            <otherwise>
                <!-- Restore original body -->
                <setBody>
                    <simple>${header.shopify_payload}</simple>
                </setBody>

                <!-- Identify the transaction, its parent order and the cash-in gate
                     fields. The payload is one REST Transaction object. -->
                <setHeader name="transaction_id">
                    <jsonpath>$.id</jsonpath>
                </setHeader>
                <setHeader name="order_id">
                    <jsonpath>$.order_id</jsonpath>
                </setHeader>
                <setHeader name="txn_kind">
                    <jsonpath suppressExceptions="true">$.kind</jsonpath>
                </setHeader>
                <setHeader name="txn_status">
                    <jsonpath suppressExceptions="true">$.status</jsonpath>
                </setHeader>

                <!-- Cash-in gate (mirror of commerce.Payments.isCashIn): only a
                     successful sale/capture becomes a payment node. The authoritative
                     judgment re-runs in recordPayment.groovy; this gate just keeps
                     non-payments out of the store entirely. Camel's simple language
                     does not support parenthesis grouping in predicates, so the
                     (kind OR kind) AND (status OR ...) conjunction is evaluated as
                     two nested steps folding into one txn_cash_in flag header. -->
                <setHeader name="txn_cash_in">
                    <constant>false</constant>
                </setHeader>
                <choice>
                    <when>
                        <simple>${header.txn_kind} == 'sale' || ${header.txn_kind} == 'capture'</simple>
                        <choice>
                            <when>
                                <simple>${header.txn_status} == 'success' || ${header.txn_status} == null || ${header.txn_status} == ''</simple>
                                <setHeader name="txn_cash_in">
                                    <constant>true</constant>
                                </setHeader>
                            </when>
                        </choice>
                    </when>
                </choice>

                <choice>
                    <when>
                        <simple>${header.txn_cash_in} == 'true'</simple>

                        <!-- Set business key for history tracking (the transaction ID) -->
                        <setHeader name="mi:history.businessKey">
                            <jsonpath>$.id</jsonpath>
                        </setHeader>

                        <!-- Generate file path: /content/commerce/payments/raw/{yyyy}/{MM}/transaction_{id}.json,
                             nested by the transaction's processed_at (fallback created_at)
                             in UTC — the shared fold rule, matching PaymentMirror's
                             paid-at placement. The read path recurses on typed props,
                             so placement is cosmetic. -->
                        <setHeader name="raw_store">
                            <constant>payments</constant>
                        </setHeader>
                        <setHeader name="raw_name">
                            <simple>transaction_${header.transaction_id}.json</simple>
                        </setHeader>
                        <setHeader name="raw_at">
                            <jsonpath suppressExceptions="true">$.processed_at</jsonpath>
                        </setHeader>
                        <setHeader name="raw_at2">
                            <jsonpath suppressExceptions="true">$.created_at</jsonpath>
                        </setHeader>
                        <toD uri="cms:/etc/commerce/scripts/shopify/deriveRawPath.groovy?inputs=raw_*&amp;outputs=rawPath"/>
                        <setHeader name="paymentPath">
                            <simple>${header.rawPath}</simple>
                        </setHeader>

                        <!-- Restore the raw transaction JSON (the script call replaced the body). -->
                        <setBody>
                            <simple>${header.shopify_payload}</simple>
                        </setBody>

                        <!-- Save raw JSON to JCR -->
                        <toD uri="cms:store?mimeType=application/json&amp;path=${header.paymentPath}"/>

                        <!-- Core identity props. The derived money/date facet props
                             (payment_amount(_base), paid_at, kind, gateway,
                             currency) are computed from the body by recordPayment.groovy
                             via the SAME prop writer the bulk import uses. -->
                        <setHeader name="commerce:transaction_id">
                            <jsonpath>$.id</jsonpath>
                        </setHeader>
                        <setHeader name="commerce:order_id">
                            <jsonpath>$.order_id</jsonpath>
                        </setHeader>
                        <!-- commerce:status is the integration processing lifecycle status. -->
                        <setHeader name="commerce:status">
                            <constant>received</constant>
                        </setHeader>
                        <!-- Clear any previous error metadata -->
                        <setHeader name="commerce:errorMessage">
                            <simple>${null}</simple>
                        </setHeader>
                        <setHeader name="commerce:stackTrace">
                            <simple>${null}</simple>
                        </setHeader>

                        <!-- Shopify entity ids are String (equality/lookup only, never
                             range-queried, and can exceed a UI-safe integer). $.id /
                             $.order_id yield JSON numbers, so coerce them to String. -->
                        <toD uri="transform:toString?targets=commerce:transaction_id,commerce:order_id"/>

                        <!-- Write metadata to JCR node properties -->
                        <toD uri="cms:setProperties?path=${header.paymentPath}&amp;includes=commerce:*"/>

                        <!-- Derive + persist the payment facts (amounts, base-currency
                             decision, the paid_at date axis) from the stored body. -->
                        <toD uri="cms:/etc/commerce/scripts/shopify/recordPayment.groovy?inputs=paymentPath,order_id"/>

                        <log message="Payment transaction ${header.transaction_id} (order ${header.order_id}) saved to ${header.paymentPath}"
                             loggingLevel="INFO"/>
                    </when>
                    <otherwise>
                        <!-- authorization / void / refund / non-success: no money in — not a payment node. -->
                        <log message="Transaction ${header.transaction_id} (order ${header.order_id}) kind=${header.txn_kind} status=${header.txn_status} - not a cash-in event, skipping"
                             loggingLevel="INFO"/>
                    </otherwise>
                </choice>

                <!-- Record webhook as processed (idempotency marker) -->
                <setBody>
                    <simple>${date-with-timezone:now:UTC:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}</simple>
                </setBody>
                <toD uri="cms:store?path=/content/commerce/history/webhooks/${date-with-timezone:now:UTC:yyyy}/${date-with-timezone:now:UTC:MM}/${header.shopify_webhook_id}&amp;mimeType=text/plain"/>
            </otherwise>
        </choice>

        <!-- Record processing health (success): received_at -> completion latency. -->
        <setHeader name="health_group">
            <constant>route</constant>
        </setHeader>
        <setHeader name="health_name">
            <simple>${header.shopify_topic}</simple>
        </setHeader>
        <setHeader name="health_ok">
            <constant>true</constant>
        </setHeader>
        <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
    </route>

</camel>
