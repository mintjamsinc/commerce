<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <routeConfiguration id="shopify-order-paid-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <redeliveryPolicy maximumRedeliveries="3" redeliveryDelay="5000"/>

            <!-- Log error details -->
            <log message="Shopify order paid error [${exchangeId}]: ${exception.message} [file: ${header.orderPath}]"
                 loggingLevel="ERROR"/>

            <!-- Set error metadata as headers for JCR properties -->
            <setHeader name="commerce:status">
                <constant>error</constant>
            </setHeader>
            <setHeader name="commerce:errorMessage">
                <simple>${exception.message}</simple>
            </setHeader>
            <setHeader name="commerce:stackTrace">
                <simple>${exception.stacktrace}</simple>
            </setHeader>
            <toD uri="transform:truncateString?targets=commerce:stackTrace&amp;maxLength=2048"/>

            <!-- Write error metadata to JCR node properties -->
            <toD uri="cms:setProperties?path=${header.orderPath}&amp;includes=commerce:*"/>
            <!-- Move file to error folder -->
            <toD uri="cms:move?sourcePath=${header.orderPath}&amp;destPath=/content/commerce/orders/error"/>

            <!-- Record processing health (error) -->
            <setHeader name="health_group">
                <constant>route</constant>
            </setHeader>
            <setHeader name="health_name">
                <simple>${header.shopify_topic}</simple>
            </setHeader>
            <setHeader name="health_ok">
                <constant>false</constant>
            </setHeader>
            <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
        </onException>
    </routeConfiguration>

    <route id="shopify-order-paid" routeConfigurationId="shopify-order-paid-error-handler">
        <from uri="direct:shopify-order-paid"/>

        <!-- Include headers for history tracking -->
        <setHeader name="mi:history.header.includes">
            <constant>commerce:*</constant>
        </setHeader>

        <!-- Inherit the caller's identity from the ingest core (the service user
             for webhook traffic, or the operator who replayed the event); fall back
             to the service user when none was supplied. -->
        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>

        <!-- Save original body before idempotency check (cms:exists overwrites body) -->
        <setHeader name="shopify_payload">
            <simple>${body}</simple>
        </setHeader>

        <!-- Idempotency check: skip if this webhook was already processed -->
        <toD uri="cms:exists?query=/jcr:root/content/commerce/history/webhooks/${header.shopify_webhook_id}&amp;@header.webhookAlreadyProcessed=exists"/>

        <choice>
            <when>
                <simple>${header.webhookAlreadyProcessed} == true &amp;&amp; ${header.replay} != 'true'</simple>
                <log message="Duplicate webhook ${header.shopify_webhook_id} - skipping"
                     loggingLevel="INFO"/>
            </when>
            <otherwise>
                <!-- Restore original body -->
                <setBody>
                    <simple>${header.shopify_payload}</simple>
                </setBody>

                <!-- Set business key for history tracking (e.g. order ID) -->
                <setHeader name="mi:history.businessKey">
                    <jsonpath>$.id</jsonpath>
                </setHeader>

                <!-- Generate file path: /content/commerce/orders/raw/2026/02/order_{id}.json -->
                <setHeader name="order_id">
                    <jsonpath>$.id</jsonpath>
                </setHeader>
                <setHeader name="orderPath">
                    <simple>/content/commerce/orders/raw/${date:now:yyyy}/${date:now:MM}/order_${header.order_id}.json</simple>
                </setHeader>

                <!-- Save raw JSON to JCR -->
                <toD uri="cms:store?mimeType=application/json&amp;path=${header.orderPath}"/>

                <!-- Parse order metadata and set as JCR properties -->
                <setHeader name="commerce:order_id">
                    <jsonpath>$.id</jsonpath>
                </setHeader>
                <setHeader name="commerce:customer_email">
                    <jsonpath>$.contact_email</jsonpath>
                </setHeader>
                <setHeader name="commerce:total_price">
                    <jsonpath>$.total_price</jsonpath>
                </setHeader>
                <setHeader name="commerce:currency">
                    <jsonpath>$.currency</jsonpath>
                </setHeader>
                <setHeader name="commerce:order_number">
                    <jsonpath>$.order_number</jsonpath>
                </setHeader>
                <!-- commerce:source_status mirrors Shopify's business status for the
                     order (financial_status, e.g. paid / pending / refunded). It is
                     the order's own state in the source system, NOT our processing
                     state. -->
                <setHeader name="commerce:source_status">
                    <jsonpath>$.financial_status</jsonpath>
                </setHeader>
                <!-- commerce:status is the integration processing lifecycle status,
                     consistent with products. See docs/commerce-status.md. -->
                <setHeader name="commerce:status">
                    <constant>received</constant>
                </setHeader>
                <!-- Clear any previous error metadata -->
                <setHeader name="commerce:errorMessage">
                    <simple>${null}</simple>
                </setHeader>
                <setHeader name="commerce:stackTrace">
                    <simple>${null}</simple>
                </setHeader>

                <!-- Normalize property types (e.g. total_price should be decimal) -->
                <toD uri="transform:toDecimal?targets=commerce:total_price"/>

                <!-- Write metadata to JCR node properties -->
                <toD uri="cms:setProperties?path=${header.orderPath}&amp;includes=commerce:*"/>

                <log message="Order ${header.order_id} saved to ${header.orderPath}"
                     loggingLevel="INFO"/>

                <!-- Record webhook as processed (idempotency marker) -->
                <setBody>
                    <simple>${date:now:yyyy-MM-dd'T'HH:mm:ss.SSSZ}</simple>
                </setBody>
                <toD uri="cms:store?path=/content/commerce/history/webhooks/${date:now:yyyy}/${date:now:MM}/${header.shopify_webhook_id}&amp;mimeType=text/plain"/>

                <!-- Guard against duplicate workflow instances for the same order.
                     Shopify can re-deliver or emit related order webhooks in quick
                     succession; without this check each one could spawn a parallel
                     order-review-flow for the same order. We query for an already-running
                     instance keyed by the order ID (businessKey) and only start a new one
                     when none is active. -->
                <toD uri="bpm:queryProcessInstances?processDefinitionKey=order-review-flow&amp;businessKey=${header.order_id}&amp;active=true&amp;@header.runningProcessCount=count"/>
                <choice>
                    <when>
                        <simple>${header.runningProcessCount} &gt; 0</simple>
                        <log message="order-review-flow already running for order ${header.order_id} (active=${header.runningProcessCount}) - skipping new instance"
                             loggingLevel="INFO"/>
                    </when>
                    <otherwise>
                        <!-- Start the order review workflow: screen the order and, when a
                             rule matches, raise a manual "Order Review" task. -->
                        <toD uri="bpm:startProcess?processDefinitionKey=order-review-flow&amp;businessKey=${header.order_id}&amp;includes=order_id,orderPath"/>
                    </otherwise>
                </choice>

                <!-- Detect backorders / pre-orders for this order (#12): record a
                     line-level backorder for any line short on stock or sold ahead
                     as a pre-order. Defensive - never moves the order to error. -->
                <toD uri="cms:/etc/commerce/scripts/shopify/detectBackorders.groovy?inputs=orderPath,order_id"/>
            </otherwise>
        </choice>

        <!-- Record processing health (success): received_at -> completion latency. -->
        <setHeader name="health_group">
            <constant>route</constant>
        </setHeader>
        <setHeader name="health_name">
            <simple>${header.shopify_topic}</simple>
        </setHeader>
        <setHeader name="health_ok">
            <constant>true</constant>
        </setHeader>
        <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
    </route>

</camel>
