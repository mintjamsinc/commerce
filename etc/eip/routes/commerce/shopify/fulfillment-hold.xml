<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <routeConfiguration id="shopify-fulfillment-hold-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <redeliveryPolicy maximumRedeliveries="3" redeliveryDelay="5000"/>
            <log message="Shopify fulfillment hold error [${exchangeId}]: ${exception.message} [order: ${header.order_id}]"
                 loggingLevel="ERROR"/>

            <!-- Record processing health (error). Like orders/updated this is a
                 mirror refresh: it never touches commerce:status or the workflow,
                 so a failure only degrades the hold badge, never the lifecycle. -->
            <setHeader name="health_group">
                <constant>route</constant>
            </setHeader>
            <setHeader name="health_name">
                <simple>${header.shopify_topic}</simple>
            </setHeader>
            <setHeader name="health_ok">
                <constant>false</constant>
            </setHeader>
            <setHeader name="health_error">
                <simple>${exception.message}</simple>
            </setHeader>
            <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
        </onException>
    </routeConfiguration>

    <!--
      fulfillment_orders/placed_on_hold and fulfillment_orders/hold_released
      ingestion. Shopify models "hold" on the FULFILLMENT ORDER, not the order:
      the REST order payload (orders/updated) carries no hold state at all, so
      these two topics are the only webhook signal that an order is on hold.

      The route mirrors the hold onto the PARENT ORDER node — the set of held
      fulfillment-order ids plus a derived boolean commerce:fulfillment_hold and
      a typed timestamp — which the Fulfill Order task form reads to hide the
      "Mark as fulfilled" action while held. Tracking held FO ids (not a bare
      boolean) keeps a multi-FO order held until EVERY hold is released.

      Mirror-only: it does NOT set commerce:status and does NOT start or stop any
      workflow. Idempotent: a duplicate delivery rewrites the same set.

      These topics deliver a SLIM payload (the fulfillment order's GraphQL gid +
      status; no parent order id), so the script resolves the parent order via
      the Admin API — the hold mirror therefore requires adminApi to be
      configured, like every other outbound/lookup feature.
    -->
    <route id="shopify-fulfillment-hold" routeConfigurationId="shopify-fulfillment-hold-error-handler">
        <from uri="direct:shopify-fulfillment-hold"/>

        <!-- Inherit the caller's identity from the ingest core (the service user
             for webhook traffic, or the operator who replayed the event); fall back
             to the service user when none was supplied. -->
        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>

        <!-- The fulfillment order's id (a GraphQL gid in these payloads). -->
        <setHeader name="fulfillment_order_id">
            <jsonpath suppressExceptions="true">$.fulfillment_order.id</jsonpath>
        </setHeader>
        <!-- Parent order id: absent from the documented slim payload, but read
             defensively in case a payload version carries it — saves the script
             an Admin API lookup when present. -->
        <setHeader name="order_id">
            <jsonpath suppressExceptions="true">$.fulfillment_order.order_id</jsonpath>
        </setHeader>

        <!-- Flag write happens in the script: it resolves the parent order
             (Admin API when the payload lacks it), looks up the EXISTING order
             mirror node (never creates one for an order we have not ingested)
             and updates the held-FO set by topic. -->
        <toD uri="cms:/etc/commerce/scripts/shopify/setFulfillmentHold.groovy?inputs=order_id,fulfillment_order_id,shopify_topic"/>

        <log message="Order ${header.order_id} fulfillment hold mirrored (${header.shopify_topic})"
             loggingLevel="INFO"/>

        <!-- Record processing health (success): received_at -> completion latency. -->
        <setHeader name="health_group">
            <constant>route</constant>
        </setHeader>
        <setHeader name="health_name">
            <simple>${header.shopify_topic}</simple>
        </setHeader>
        <setHeader name="health_ok">
            <constant>true</constant>
        </setHeader>
        <toD uri="cms:/etc/commerce/scripts/shopify/recordHealth.groovy?inputs=health_*,received_at"/>
    </route>

</camel>
