<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <!-- Swallow scheduler failures: the reconcile scheduler must never surface errors. -->
    <routeConfiguration id="commerce-reconcile-scheduler-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <log message="commerce-reconcile-scheduler error: ${exception.message}"
                 loggingLevel="WARN"/>
        </onException>
    </routeConfiguration>

    <!--
      Wall-clock scheduler for reconciliation. The CMS has no cron primitive, so a 1-minute
      heartbeat runs the schedule dispatcher, which reads the reconcile configuration's `schedules`
      ({ at: "HH:mm" in UTC, scope: diff|inventory }) and at each due minute fires that pass once
      cluster-wide: `diff` -> direct:commerce-reconcile, `inventory` -> a full audit via the
      Bulk job broker.

      The hourly round-robin baseline was retired on 2026-06-30, so these schedules are now the
      only periodic reconciliation trigger (not additive to any baseline). Runs as the service user.
    -->
    <route id="commerce-reconcile-scheduler" routeConfigurationId="commerce-reconcile-scheduler-error-handler">
        <from uri="timer:commerce-reconcile-scheduler?period=60000&amp;delay=120000"/>

        <setHeader name="runAs">
            <constant>commerce-service-user</constant>
        </setHeader>

        <toD uri="cms:/etc/commerce/scripts/scheduleReconcile.groovy"/>
    </route>

</camel>
