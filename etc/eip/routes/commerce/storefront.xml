<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <!-- Swallow failures: catalog publishing must never surface errors. -->
    <routeConfiguration id="commerce-catalog-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <log message="commerce-catalog-publish error: ${exception.message}"
                 loggingLevel="WARN"/>
        </onException>
    </routeConfiguration>

    <!--
      Publish the public storefront catalog (category F, #20). Rebuilds the sanitized
      public projection under /content/public/commerce/catalog/ every 5 minutes (after
      a 1-minute warm-up) as the service user. Per-stock-change inventory freshness
      (#21) is handled promptly by publishInventory.groovy on the inventory route;
      this timer keeps product content + the index current and prunes removed
      products. On-demand rebuild comes through direct:commerce-catalog-publish.
    -->
    <route id="commerce-catalog-publish" routeConfigurationId="commerce-catalog-error-handler">
        <from uri="timer:commerce-catalog-publish?period=300000&amp;delay=60000"/>
        <setHeader name="runAs">
            <constant>commerce-service-user</constant>
        </setHeader>
        <toD uri="cms:/etc/commerce/scripts/commerce/publishCatalog.groovy"/>
    </route>

    <route id="commerce-catalog-publish-run" routeConfigurationId="commerce-catalog-error-handler">
        <from uri="direct:commerce-catalog-publish"/>
        <!-- On-demand rebuild from the storefront endpoint: honor the caller-supplied
             runAs (the operator who triggered it) so the public projection it writes
             is attributed to them; fall back to the service user (the timer path). -->
        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>
        <toD uri="cms:/etc/commerce/scripts/commerce/publishCatalog.groovy"/>
    </route>

    <!--
      Publish content-commerce landing pages (category F, #22). Rebuilds the public
      page projection under /content/public/commerce/pages/ every 5 minutes (after a
      90-second warm-up, so the catalog it resolves product blocks against is fresh).
      On-demand rebuild comes through direct:commerce-pages-publish.
    -->
    <route id="commerce-pages-publish" routeConfigurationId="commerce-catalog-error-handler">
        <from uri="timer:commerce-pages-publish?period=300000&amp;delay=90000"/>
        <setHeader name="runAs">
            <constant>commerce-service-user</constant>
        </setHeader>
        <toD uri="cms:/etc/commerce/scripts/commerce/publishPages.groovy"/>
    </route>

    <route id="commerce-pages-publish-run" routeConfigurationId="commerce-catalog-error-handler">
        <from uri="direct:commerce-pages-publish"/>
        <!-- On-demand rebuild from the storefront endpoint: honor the caller-supplied
             runAs (the operator who triggered it) so the public projection it writes
             is attributed to them; fall back to the service user (the timer path). -->
        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>
        <toD uri="cms:/etc/commerce/scripts/commerce/publishPages.groovy"/>
    </route>

</camel>
