<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <!-- Swallow batch failures: reconciliation must never surface errors. -->
    <routeConfiguration id="commerce-reconcile-error-handler">
        <onException>
            <exception>java.lang.Exception</exception>
            <handled>
                <constant>true</constant>
            </handled>
            <log message="commerce-reconcile error: ${exception.message}"
                 loggingLevel="WARN"/>
        </onException>
    </routeConfiguration>

    <!--
      On-demand reconciliation (diff scope: status / price). The reconcile endpoint and the
      `diff` schedule (scheduleReconcile.groovy) send here. Honors the caller-supplied runAs
      (the operator who triggered it), falling back to the service user, and defaults the
      scope to `diff`.

      The hourly round-robin baseline timer was RETIRED on 2026-06-30: status/price drift is
      caught by `diff` schedules; the full inventory audit is the Bulk job broker (`inventory`
      scope → direct:commerce-shopify-bulk-enqueue). Settings live in reconcile.yml.
    -->
    <route id="commerce-reconcile-run" routeConfigurationId="commerce-reconcile-error-handler">
        <from uri="direct:commerce-reconcile"/>

        <choice>
            <when>
                <simple>${header.runAs} == null || ${header.runAs} == ''</simple>
                <setHeader name="runAs">
                    <constant>commerce-service-user</constant>
                </setHeader>
            </when>
        </choice>

        <choice>
            <when>
                <simple>${header.scope} == null || ${header.scope} == ''</simple>
                <setHeader name="scope">
                    <constant>diff</constant>
                </setHeader>
            </when>
        </choice>

        <toD uri="cms:/etc/commerce/scripts/commerce/reconcile.groovy?inputs=scope"/>
    </route>

</camel>
